---
const links = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
];
const current = Astro.url.pathname;
---

<header>
  <nav>
    <a class="brand" href="/">tbill.us</a>
    <ul>
      {
        links.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={current === href ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  header {
    border-bottom: 1px solid var(--border);
  }
  nav {
    max-width: var(--max);
    margin: 0 auto;
    padding: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    font-weight: 700;
    text-decoration: none;
    color: var(--text);
  }
  ul {
    list-style: none;
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
  }
  ul a {
    text-decoration: none;
    color: var(--muted);
  }
  ul a[aria-current='page'],
  ul a:hover {
    color: var(--accent);
  }
</style>
